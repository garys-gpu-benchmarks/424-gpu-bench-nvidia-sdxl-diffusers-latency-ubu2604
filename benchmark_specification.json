    "field_name": "run_benchmark Command Plus Options for Smoke Run (One minute or less)",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --model-name sdxl-base-1.0 --precision fp16 --scheduler euler --prompt-source synthetic --image-resolution 64 --num-images 1 --num-inference-steps 2 --guidance-scale 0 --seed 42 --prompt-len 32 --batch-size 1"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run (3 to 5 minutes)",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --model-name sdxl-base-1.0 --precision fp16 --scheduler euler --prompt-source synthetic --image-resolution 512 --num-images 32 --num-inference-steps 30 --guidance-scale 0 --seed 42 --prompt-len 32 --batch-size 1"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run (8 to 15 minutes)",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --extended --validate --model-name sdxl-base-1.0 --precision fp16 --scheduler euler --prompt-source synthetic --image-resolution 1024 --num-images 72 --num-inference-steps 50 --guidance-scale 0 --seed 42 --prompt-len 32 --batch-size 1"
  },
